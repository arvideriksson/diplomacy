{
  "name": "diplomacy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:live": "BACKEND=live vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:7p": "node --experimental-strip-types scripts/seven-player-game.mjs",
    "test:7p:live": "BACKEND=live node --experimental-strip-types scripts/seven-player-game.mjs",
    "build:edge": "esbuild src/lib/adjudicator/edge-entry.ts --bundle --format=esm --platform=neutral --outfile=supabase/functions/adjudicate/_engine.mjs",
    "map:1900": "node --experimental-strip-types tools/variants/1900/build.mjs",
    "sql:current": "node scripts/current-sql.mjs",
    "db:start": "npm run build:edge && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "npm run build:edge && supabase db reset",
    "db:status": "supabase status",
    "live:push": "node --experimental-strip-types scripts/live.mjs push",
    "live:deploy-functions": "npm run build:edge && node --experimental-strip-types scripts/live.mjs deploy-functions",
    "live:diagnose-push": "node --experimental-strip-types scripts/live.mjs diagnose-push",
    "live:functions-list": "node --experimental-strip-types scripts/live.mjs functions-list",
    "live:ping-notify": "node --experimental-strip-types scripts/live.mjs ping-notify",
    "live:secrets-list": "node --experimental-strip-types scripts/live.mjs secrets-list",
    "live:rotate-adjudicator-secret": "node --experimental-strip-types scripts/live.mjs rotate-adjudicator-secret",
    "live:secrets": "node --experimental-strip-types scripts/live.mjs secrets",
    "postinstall": "node scripts/install-supabase-guard.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.3",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.27.7",
    "playwright": "^1.60.0",
    "polygon-clipping": "^0.15.7",
    "supabase": "^2.122.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@thi.ng/bitstream": "^2.4.55",
    "svelte-routing": "^2.13.0"
  }
}
